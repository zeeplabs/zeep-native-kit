{
  "name": "@zeep/logger",
  "version": "0.1.0",
  "description": "Log viewer and controls for zeep-native-kit apps",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeeplabs/zeep-native-kit.git",
    "directory": "packages/@zeep/logger"
  },
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@tauri-apps/api": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^25",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4.0",
    "vitest": "^2"
  }
}
