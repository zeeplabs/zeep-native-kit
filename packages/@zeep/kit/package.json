{
  "name": "@zeep/kit",
  "version": "0.1.0",
  "description": "Umbrella package — re-exports all @zeep modules",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeeplabs/zeep-native-kit.git",
    "directory": "packages/@zeep/kit"
  },
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@zeep/core": "workspace:*",
    "@zeep/ui": "workspace:*",
    "@zeep/logger": "workspace:*",
    "@zeep/updater": "workspace:*",
    "@zeep/ai": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^25",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.4.0",
    "vitest": "^2"
  }
}
